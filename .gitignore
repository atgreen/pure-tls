# Common Lisp compilation artifacts
*.fasl
*.fas
*.lib
*.o
*.lx64fsl
*.dx64fsl

# ASDF cache
.cache/

# ocicl dependencies (fetched at build time)
ocicl/
ocicl.csv
systems.csv

# Editor files
*~
\#*\#
.#*

# Test files
test-connect.lisp
test-load.lisp
test-*.lisp
RCS

# Markdown files in top level, except the project docs listed below.
# Every top-level .md that should be tracked needs an entry here: `git add`
# SILENTLY SKIPS an ignored path, so a missing exception means the file never
# gets committed and the omission is easy to miss in a large diff.
/*.md
!/README.md
!/CHANGELOG.md
!/AGENTS.md
!/SECURITY.md
# Explicitly ignore local review artifacts
C-REVIEW.md

# Local planning docs
ROADMAP.md
PROJECT.md

# Build artifacts
pure-tls-shim

# Generated test certificates
test/chrome-interop/localhost-cert.pem
test/chrome-interop/localhost-key.pem

# Large test vector files (download separately)
test/vectors/*.rsp
.codex

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
